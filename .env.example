# =============================================================================
# Kinikh IVR — Environment Variables
# Copy to .env and fill in all required values before starting.
# Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Kinikh IVR"
APP_ENV=development          # development | production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_replace_with_64_char_random_hex_string

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://kinikh:password@localhost:5432/kinikh_ivr
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Fast live replies only; leave empty to inherit OPENAI_MODEL.
# Non-reasoning GPT-4.1 models skip OPENAI_REASONING_EFFORT automatically.
OPENAI_LIVE_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1024
OPENAI_REASONING_EFFORT=minimal
# Live-call turn taking. A caller pause shorter than END_OF_SPEECH_MS stays
# in the same turn; speech during assistant playback must stay above
# BARGE_IN_MIN_RMS_ENERGY for BARGE_IN_MIN_ACTIVE_MS (dips up to
# BARGE_IN_GAP_TOLERANCE_MS allowed) to interrupt — this is the echo guard.
END_OF_SPEECH_MS=900
BARGE_IN_MIN_ACTIVE_MS=350
BARGE_IN_MIN_RMS_ENERGY=600
BARGE_IN_GAP_TOLERANCE_MS=120
# Continuation grace, measured from speech-end detection (STT time counts).
# Clear short answers such as yes/no/haan respond immediately.
# Extra wait when the transcript sounds unfinished (ends with "aur", "but",
# "matlab", a comma, or is under 3 words) before replying; 0 disables.
UNFINISHED_TURN_EXTRA_MS=1200
# Caller speech in the first N ms of each assistant sentence (when our own
# echo is loudest) cannot interrupt on its own; it is still captured.
BARGE_IN_GRACE_MS=500
TTS_STREAMING_ENABLED=true
# Prepare the next sentence before playback drains; wire pacing stays bounded.
TTS_LOOKAHEAD_MS=1200
# Live-call provider deadlines before the caller hears a spoken fallback.
STT_TIMEOUT_SECONDS=8
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=8
# Speech-to-text model (gpt-4o-transcribe is much more accurate than
# whisper-1 on phone audio and Hindi/Hinglish; whisper-1 is the automatic
# fallback if the model is unavailable on your OpenAI account).
STT_MODEL=gpt-4o-transcribe
STT_FALLBACK_MODEL=whisper-1
# Adaptive noise gate: caller speech must be this many times louder than the
# line's background noise (0 = off). Raise to 4 for very noisy callers.
NOISE_FLOOR_MULTIPLIER=3.0
NOISE_GATE_MAX_RMS=2000
# Silence handling: re-prompt after N seconds of caller silence, hang up
# politely after MAX_SILENCE_REPROMPTS unanswered prompts (0 = never).
SILENCE_REPROMPT_SECONDS=8
MAX_SILENCE_REPROMPTS=2

# Language Stability
LANGUAGE_MIN_WORDS=3
# A set call language switches only on a turn of >= N content words with
# >= RATIO of them in the other language, or on an explicit request.
LANGUAGE_SWITCH_MIN_WORDS=4
LANGUAGE_SWITCH_RATIO=0.7
# Extra comma-separated acknowledgements that never change the call language
LANGUAGE_EXTRA_ACKNOWLEDGEMENTS=

# TTS pronunciation fixes, applied just before synthesis (whole word,
# case-sensitive, in order). किनिख uses short vowels, avoiding Ki-nikh. _HI is applied first when speaking hi / hi-en.
TTS_PRONUNCIATIONS="KINIKH=Kinikh;Kinikh=किनिख;evolKun=evol-kun;KRIL=K R I L;BrandWorks=Brand Works;Landcraft=Land craft"
TTS_PRONUNCIATIONS_HI="Kinikh=किनिख;KINIKH=किनिख"
# Other ALL-CAPS words of 4+ letters are spoken in Title case.
TTS_KEEP_ACRONYMS="CRM,ERP,MIS,GST,HR,EA,NGO"

# Speech-style (accent) detection — TTS personalisation only; never infers
# where a caller is from. No acoustic model ships yet: provider "none" always
# reports neutral_indian. Modes: disabled | log_only | adaptive_tts.
ACCENT_DETECTION_ENABLED=false
ACCENT_DETECTION_MODE=log_only
ACCENT_DETECTOR_PROVIDER=none
ACCENT_MIN_AUDIO_MS=4000
ACCENT_TIMEOUT_MS=1500
ACCENT_MIN_CONFIDENCE=high
ACCENT_MIN_EVIDENCE=2
ACCENT_MAX_ANALYSES=3


# ---------------------------------------------------------------------------
# Public URL (permanent tunnel) — see docs/permanent_tunnel.md
# ---------------------------------------------------------------------------
# Fixed public HTTPS address of this backend. Set automatically by
# scripts/windows/setup-permanent-tunnel.ps1 (Cloudflare) or start-ngrok.ps1.
PUBLIC_BASE_URL=
CLOUDFLARE_TUNNEL_NAME=
# ngrok alternative (no domain needed): your free static domain
NGROK_DOMAIN=

# ---------------------------------------------------------------------------
# Text-to-speech provider
# ---------------------------------------------------------------------------
# elevenlabs | openai. OpenAI TTS is the automatic fallback for
# elevenlabs.
TTS_PROVIDER=elevenlabs

# ---------------------------------------------------------------------------
# ElevenLabs TTS (optional — only used when TTS_PROVIDER=elevenlabs)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=el-...
ELEVENLABS_VOICE_ID_EN=your-english-voice-id
ELEVENLABS_VOICE_ID_HI=your-hindi-voice-id
# eleven_flash_v2_5 = lowest latency; eleven_multilingual_v2 = best quality.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# voice_settings (speaker boost stays off on the 8 kHz phone line)
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.15
ELEVENLABS_SPEED=1.0
# Optional curated voices per language + speech style (adaptive_tts only).
# Missing ones fall back to the neutral voice for the language.
ELEVENLABS_VOICE_EN_NEUTRAL=
ELEVENLABS_VOICE_HI_NEUTRAL=
ELEVENLABS_VOICE_HINGLISH_NEUTRAL=
ELEVENLABS_VOICE_EN_GUJARATI=
ELEVENLABS_VOICE_HINGLISH_GUJARATI=
ELEVENLABS_VOICE_EN_PUNJABI=
ELEVENLABS_VOICE_HINGLISH_PUNJABI=

# ---------------------------------------------------------------------------
# Exotel (Telephony)
# ---------------------------------------------------------------------------
# Standard REST API auth (from your Exotel dashboard's API Credentials
# section — Account SID, plus the API Key/API Token pair used as the Basic
# Auth username/password): https://<api_key>:<api_token>@<subdomain>/v1/Accounts/<sid>/...
EXOTEL_SID=your-exotel-account-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_TOKEN=your-exotel-api-token
EXOTEL_SUBDOMAIN=api.exotel.com

# Outbound calling only (ExoPhone CallerId) — not required for inbound
# webhooks, REST API auth, or Test Connection.
EXOTEL_CALLER_ID=+91XXXXXXXXXX

# App-generated secret (`openssl rand -hex 32`). Exotel does NOT sign its
# webhooks, so every /telephony/incoming and /telephony/status request must
# carry this secret in ONE of these forms or it is rejected with 401:
#   1. Exotel flow URL: https://<host>/api/v1/telephony/incoming?webhook_token=<secret>
#      (same for /status) — the form Exotel itself can send;
#   2. HTTP Basic auth whose password is the secret (https://exotel:<secret>@<host>/...);
#   3. X-Exotel-Signature: lowercase hex HMAC-SHA256 of the exact request
#      body, for a trusted signing proxy in front of the app.
EXOTEL_WEBHOOK_SECRET=CHANGE_ME_replace_with_random_string
# Optional defence in depth recommended by Exotel: only accept webhooks from
# Exotel's egress IP ranges (comma-separated CIDRs). Empty = no IP check.
# Requires nginx to pass the real client address (see docker/nginx.conf).
EXOTEL_ALLOWED_CIDRS=
STREAM_TOKEN_TTL_SECONDS=60

# Live call transfer to a person (see docs/call_transfer.md).
# TRANSFER_NUMBERS: ";" separates routes and "|" separates backup numbers;
# any area not listed (or "general") goes to TRANSFER_DEFAULT_NUMBER.
# TRANSFER_HOURS: when a person can take the call, in India time, e.g.
# "Mon-Sat 10:00-19:00" or "Mon-Fri 10:00-19:00, Sat 10:00-14:00". Outside
# these hours the assistant offers a callback instead of a transfer.
TRANSFER_ENABLED=true
TRANSFER_DEFAULT_NUMBER=+918958815375
TRANSFER_NUMBERS=rural=+917088075375;stay=+918394945375;tech=+918650075375;brand=+919568365375;infra=+918449375375;land=+917500005375;story=+919837375375;ngo=+918011161199;accounts=+917618445375;support=+918958815375;ea=+919012345375
TRANSFER_HOURS=Mon-Sat 10:00-19:00

# Deprecated, unused — earlier versions of this app incorrectly used this as
# the Basic Auth password instead of EXOTEL_TOKEN. Safe to delete; kept
# optional only so old .env files with it set still load.
# EXOTEL_API_SECRET=

# ---------------------------------------------------------------------------
# SMTP Email
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@kinikh.com
SMTP_FROM_NAME="Kinikh IVR"
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_replace_with_64_char_random_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# Admin login (single operator account)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@kinikh.com
# Generate with: python -c "from app.core.security import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash_of_admin_password

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_CALLS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ---------------------------------------------------------------------------
# Company
# ---------------------------------------------------------------------------
COMPANY_NAME="Kinikh"
COMPANY_WEBSITE=https://kinikh.com
COMPANY_PHONE=+91XXXXXXXXXX

# ---------------------------------------------------------------------------
# RAG
# ---------------------------------------------------------------------------
RAG_KNOWLEDGE_DIR=app/data/kinikh_group
RAG_MODE=auto
RAG_FULL_CONTEXT_MAX_CHARS=40000
RAG_QUERY_TIMEOUT_MS=400

# ---------------------------------------------------------------------------
# Call recording storage
# ---------------------------------------------------------------------------
# CallRecording.audio_file_path is always relative to this directory — never
# an absolute path. Served only via the authenticated
# GET /api/v1/recordings/{id}/audio endpoint (app/core/media.py), never as a
# static file mount.
RECORDINGS_DIR=storage/recordings

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
