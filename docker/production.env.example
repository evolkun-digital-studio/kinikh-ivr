# Copy to ROOT .env on the VPS. Never commit the real file.
# Generate each application secret independently: openssl rand -hex 32
APP_ENV=production
APP_DEBUG=false
PUBLIC_BASE_URL=https://ivr.example.com
CORS_ORIGINS=["https://ivr.example.com"]
SECRET_KEY=CHANGE_ME_independent_random_64_hex_characters
JWT_SECRET_KEY=CHANGE_ME_another_independent_random_64_hex_characters
EXOTEL_WEBHOOK_SECRET=CHANGE_ME_another_independent_random_64_hex_characters
# Hex only: safe both as a PostgreSQL password and in the database URL.
DB_PASSWORD=CHANGE_ME_random_hex_database_password
# Compose injects DATABASE_URL and REDIS_URL for app and migrations.
# For manual local tooling use the appropriate externally reachable URLs.
IMAGE_REPOSITORY=ghcr.io/your-github-owner/your-repository
TLS_CERT_DIR=/opt/kinikh-ivr/certs
ACME_WEBROOT=/var/www/certbot
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o
STT_MODEL=gpt-4o-transcribe
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=CHANGE_ME
ELEVENLABS_VOICE_ID_EN=CHANGE_ME
ELEVENLABS_VOICE_ID_HI=CHANGE_ME
EXOTEL_SID=CHANGE_ME
EXOTEL_API_KEY=CHANGE_ME
EXOTEL_TOKEN=CHANGE_ME
EXOTEL_CALLER_ID=CHANGE_ME
EXOTEL_SUBDOMAIN=api.exotel.com
# Optional: provider-confirmed egress CIDRs. Do not guess these.
EXOTEL_ALLOWED_CIDRS=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=notifications@example.com
SMTP_USE_TLS=true
ADMIN_EMAIL=admin@example.com
# Single quotes preserve literal bcrypt dollar signs during Compose interpolation.
ADMIN_PASSWORD_HASH='CHANGE_ME_bcrypt_hash'
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
RECORDINGS_DIR=/app/storage/recordings
RAG_INDEX_DIR=/app/storage/rag_index
# Enable only after entering and testing your actual routing numbers.
TRANSFER_ENABLED=false
TRANSFER_DEFAULT_NUMBER=
TRANSFER_NUMBERS=
